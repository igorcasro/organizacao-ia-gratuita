// Configuração GLOBAL do OpenCode 2 com as proteções que não dependem do modo.
// Serve para que o OpenCode Desktop, a interface web (opencode pair) e o comando "opencode" puro
// tenham as mesmas proteções do script. Leia docs/interface-grafica.md antes de usar.
//
// Destino: opencode.jsonc na pasta mostrada por  opencode debug paths config
//   Windows: C:\Users\<seu usuário>\.config\opencode\opencode.jsonc   Ubuntu: ~/.config/opencode/opencode.jsonc
// Se já existir um opencode.json ou opencode.jsonc ali, faça uma cópia antes e junte as regras à mão.
//
// Substitua <CAMINHO DO REPOSITÓRIO> pela pasta deste repositório, com barras normais.
//   Exemplo no Windows: C:/Users/fulano/projetos/organizacao-ia-gratuita
//
// De propósito, este arquivo NÃO restringe provedores: as políticas globais prevalecem sobre as do
// script (packages/core/src/config/plugin/policy.ts, v2.2.6), e uma restrição aqui quebraria os modos
// local e misto. A escolha de provedores continua com o script (iniciar) e, no Desktop, com você.
// As regras de "permissions" abaixo são as mesmas de scripts/lib/opencode.mjs (conferido pelos testes).
// Consultado em 2026-11-07.
{
  "$schema": "https://opencode.ai/config.json",
  // Busca na web passa por serviços externos; bloqueada em todos os clientes.
  "policies": [
    { "action": "websearch.use", "resource": "*", "effect": "deny" }
  ],
  "permissions": [
    {"action": "webfetch", "resource": "*", "effect": "ask"},
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "read", "resource": "*.env", "effect": "deny"},
    {"action": "read", "resource": "*.env.*", "effect": "deny"},
    {"action": "read", "resource": "*.pem", "effect": "deny"},
    {"action": "read", "resource": "*.key", "effect": "deny"},
    {"action": "read", "resource": "*.p12", "effect": "deny"},
    {"action": "read", "resource": "*.pfx", "effect": "deny"},
    {"action": "read", "resource": "*.kdbx", "effect": "deny"},
    {"action": "read", "resource": "*id_rsa*", "effect": "deny"},
    {"action": "read", "resource": "*id_ed25519*", "effect": "deny"},
    {"action": "read", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "read", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "read", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "read", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "read", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "read", "resource": "*/.npmrc", "effect": "deny"},
    {"action": "read", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "read", "resource": "*/.docker/config.json", "effect": "deny"},
    {"action": "read", "resource": "*/.kube/config", "effect": "deny"},
    {"action": "edit", "resource": "*.env", "effect": "deny"},
    {"action": "edit", "resource": "*.env.*", "effect": "deny"},
    {"action": "edit", "resource": "*.pem", "effect": "deny"},
    {"action": "edit", "resource": "*.key", "effect": "deny"},
    {"action": "edit", "resource": "*.p12", "effect": "deny"},
    {"action": "edit", "resource": "*.pfx", "effect": "deny"},
    {"action": "edit", "resource": "*.kdbx", "effect": "deny"},
    {"action": "edit", "resource": "*id_rsa*", "effect": "deny"},
    {"action": "edit", "resource": "*id_ed25519*", "effect": "deny"},
    {"action": "edit", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "edit", "resource": "*/.npmrc", "effect": "deny"},
    {"action": "edit", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "edit", "resource": "*/.docker/config.json", "effect": "deny"},
    {"action": "edit", "resource": "*/.kube/config", "effect": "deny"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "shell", "resource": "curl *", "effect": "ask"},
    {"action": "shell", "resource": "wget *", "effect": "ask"},
    {"action": "shell", "resource": "scp *", "effect": "ask"},
    {"action": "shell", "resource": "sftp *", "effect": "ask"},
    {"action": "shell", "resource": "ssh *", "effect": "ask"},
    {"action": "shell", "resource": "rsync *", "effect": "ask"},
    {"action": "shell", "resource": "nc *", "effect": "ask"},
    {"action": "shell", "resource": "ncat *", "effect": "ask"},
    {"action": "shell", "resource": "telnet *", "effect": "ask"},
    {"action": "shell", "resource": "ftp *", "effect": "ask"},
    {"action": "shell", "resource": "Invoke-WebRequest *", "effect": "ask"},
    {"action": "shell", "resource": "Invoke-RestMethod *", "effect": "ask"},
    {"action": "shell", "resource": "iwr *", "effect": "ask"},
    {"action": "shell", "resource": "irm *", "effect": "ask"},
    {"action": "shell", "resource": "Start-BitsTransfer *", "effect": "ask"},
    {"action": "shell", "resource": "git push *", "effect": "ask"},
    {"action": "shell", "resource": "git remote *", "effect": "ask"},
    {"action": "shell", "resource": "npm publish *", "effect": "ask"},
    {"action": "shell", "resource": "gh *", "effect": "ask"}
  ],
  // Regras de segurança entregues ao modelo em toda sessão.
  "instructions": ["<CAMINHO DO REPOSITÓRIO>/configs/instrucoes-seguranca.md"]
}
